# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local

# vercel
.vercel

# supabase CLI cache
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# generated texture / normal-map diagnostics from npm run generate:normals
/generated/

# Large house GLBs stay on the local machine (over GitHub / Vercel file limits)
/public/Lucas Home - Full Color (2) (1).glb
/public/Lucas Home Enviz (1).glb
/public/models/house-with-generated-normals.glb
/public/models/house-with-generated-normals.report.json
